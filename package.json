{
  "name": "calais-open-commons-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-sponsor-ledger.mjs && node scripts/validate-activity-ideas.mjs && node scripts/validate-launch-gates.mjs && node scripts/validate-feature-flags.mjs && node scripts/qa-listings.mjs && node scripts/check-locale-parity.mjs && node scripts/validate-settlement-rehearsal.mjs",
    "validate:activities": "node scripts/validate-activity-ideas.mjs",
    "validate:launch": "node scripts/validate-launch-gates.mjs",
    "validate:sponsor-ledger": "node scripts/validate-sponsor-ledger.mjs",
    "sync:listings:dev": "node scripts/sync-convex-listings.mjs",
    "sync:listings:prod": "node scripts/sync-convex-listings.mjs --prod --confirm-production",
    "corrections:review": "node scripts/moderate-corrections.mjs",
    "release:listings": "node scripts/publish-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "audit:web": "node web/scripts/audit-static-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:data && npm test && npm --prefix web run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "validate:flags": "node scripts/validate-feature-flags.mjs",
    "qa:listings": "node scripts/qa-listings.mjs",
    "generate:sponsor-evidence": "node scripts/generate-sponsor-evidence.mjs",
    "generate:qr-pack": "node scripts/generate-qr-pack.mjs",
    "rehearse:settlement": "node scripts/rehearse-settlement-payout.mjs",
    "validate:locales": "node scripts/check-locale-parity.mjs",
    "verify:qr": "node scripts/verify-qr-decode.mjs",
    "test:contracts": "npm --prefix contracts ci && npm --prefix contracts test",
    "validate:settlement-rehearsal": "node scripts/validate-settlement-rehearsal.mjs",
    "deploy:testnet:guard": "node contracts/scripts/deploy-testnet.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2"
  }
}
