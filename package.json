{
  "name": "calais-open-commons-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "sync:listings:dev": "node scripts/sync-convex-listings.mjs",
    "sync:listings:prod": "node scripts/sync-convex-listings.mjs --prod --confirm-production",
    "release:listings": "node scripts/publish-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:data && npm test && npm --prefix web run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2"
  }
}
