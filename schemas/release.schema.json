{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calais-open-commons.invalid/schemas/release.schema.json",
  "title": "Calais Open Commons signed listing release",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "released_at", "expires_at", "key_id", "listing_count", "changes", "listings", "release_id"],
  "properties": {
    "format": { "const": "cocp-listing-release/v1" },
    "released_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "listing_count": { "type": "integer", "minimum": 1 },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "updated", "removed"],
      "properties": {
        "added": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "updated": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "removed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "listings": { "type": "array", "minItems": 1, "items": { "$ref": "listing.schema.json" } },
    "release_id": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" }
  }
}
