{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calais-open-commons.invalid/schemas/listing.schema.json",
  "title": "Calais Open Commons listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "categories", "audience", "location", "contact", "source", "verification", "publishable"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["emergency", "food", "water", "healthcare", "community", "legal"] } },
    "audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["all", "men", "women_children", "minors", "detained"] } },
    "location": { "type": "object", "additionalProperties": false, "required": ["label", "coordinates", "map_url"], "properties": { "label": { "type": "string", "minLength": 1 }, "coordinates": { "anyOf": [{ "type": "null" }, { "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "items": false }] }, "map_url": { "type": ["string", "null"], "format": "uri" } } },
    "contact": { "type": "object" },
    "source": { "type": "object", "additionalProperties": false, "required": ["title", "page", "notes"], "properties": { "title": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "notes": { "type": "string", "minLength": 1 } } },
    "verification": { "type": "object", "additionalProperties": false, "required": ["status", "checked_at", "expires_at", "owner"], "properties": { "status": { "enum": ["unverified", "verified", "suspended", "expired"] }, "checked_at": { "type": ["string", "null"], "format": "date-time" }, "expires_at": { "type": ["string", "null"], "format": "date-time" }, "owner": { "type": ["string", "null"] } } },
    "publishable": { "type": "boolean" }
  }
}
